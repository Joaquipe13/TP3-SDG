          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.17ivc3n0e99dkx18eolc30xt8auh].[usr:Calculation_4597520889913351:nk]' />
              <text column='[federated.17ivc3n0e99dkx18eolc30xt8auh].[usr:Calculation_4597520888983558:qk]' />
              <tooltip column='[federated.17ivc3n0e99dkx18eolc30xt8auh].[sum:Calculation_4597520888897540:qk]' />
            </encodings>
            <style>
