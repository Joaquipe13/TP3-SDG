            <column-instance column='[fecha_venta]' derivation='None' name='[none:fecha_venta:qk]' pivot='key' type='quantitative' />
            <column-instance column='[fecha_venta]' derivation='Month-Trunc' name='[tmn:fecha_venta:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4597520888266755]' derivation='User' name='[usr:Calculation_4597520888266755:qk]' pivot='key' type='quantitative' />
