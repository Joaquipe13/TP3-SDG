    <worksheet name='R12 - Clientes Valiosos'>
      <table>
        <view>
          <datasources>
            <datasource caption='ventas+' name='federated.17ivc3n0e99dkx18eolc30xt8auh' />
          </datasources>
          <datasource-dependencies datasource='federated.17ivc3n0e99dkx18eolc30xt8auh'>
            <column caption='Monto neto corregido provisional' datatype='real' name='[Calculation_4597520890634248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(FLOAT([monto_linea]) / 3)&#10;*&#10;(1 - [descuento_pct] / 100)' />
