    <worksheet name='R11 - Productos a discontinuar'>
      <table>
        <view>
          <datasources>
            <datasource caption='ventas+' name='federated.17ivc3n0e99dkx18eolc30xt8auh' />
          </datasources>
          <datasource-dependencies datasource='federated.17ivc3n0e99dkx18eolc30xt8auh'>
            <column caption='Litros corregidos' datatype='real' name='[Calculation_4597520882618369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT([litros_venta]) / 3' />
            </column>
            <column caption='Litros H1 2024' datatype='real' name='[Calculation_4597520888897540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [fecha_venta] &gt;= #2024-01-01#&#10;AND [fecha_venta] &lt;= #2024-06-30#&#10;THEN [Calculation_4597520882618369]&#10;END' />
            </column>
            <column caption='Litros H1 2025' datatype='real' name='[Calculation_4597520888938501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [fecha_venta] &gt;= #2025-01-01#&#10;AND [fecha_venta] &lt;= #2025-06-30#&#10;THEN [Calculation_4597520882618369]&#10;END' />
            </column>
            <column caption='Variación H1 2025 vs 2024' datatype='real' default-format='p0.00%' name='[Calculation_4597520888983558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_4597520888897540]) = 0 THEN&#10;    NULL&#10;ELSE&#10;    SUM([Calculation_4597520888938501]) / SUM([Calculation_4597520888897540]) - 1&#10;END' />
            </column>
            <column caption='Decisión producto' datatype='string' name='[Calculation_4597520889913351]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(SUM([Calculation_4597520888897540])) = 0&#10;AND ZN(SUM([Calculation_4597520888938501])) = 0 THEN&#10;    &quot;Sin ventas: validar datos&quot;&#10;&#10;ELSEIF ZN(SUM([Calculation_4597520888897540])) = 0 THEN&#10;    &quot;Sin base de comparación&quot;&#10;&#10;ELSEIF&#10;    SUM([Calculation_4597520888938501]) / SUM([Calculation_4597520888897540]) - 1 &lt;= -0.20&#10;THEN&#10;    &quot;Evaluar discontinuar&quot;&#10;&#10;ELSE&#10;    &quot;Mantener&quot;&#10;END' />
            </column>
            <column caption='Cod Producto (Productos.Csv)' datatype='integer' name='[cod_producto (productos.csv)]' role='measure' type='ordinal' />
            <column caption='Envase' datatype='string' name='[envase]' role='dimension' type='nominal' />
            <column caption='Fecha Venta' datatype='date' name='[fecha_venta]' role='dimension' type='ordinal' />
            <column caption='Litros Venta' datatype='string' name='[litros_venta]' role='dimension' type='nominal' />
            <column caption='Nombre' datatype='string' name='[nombre]' role='dimension' type='nominal' />
            <column-instance column='[cod_producto (productos.csv)]' derivation='None' name='[none:cod_producto (productos.csv):ok]' pivot='key' type='ordinal' />
            <column-instance column='[envase]' derivation='None' name='[none:envase:nk]' pivot='key' type='nominal' />
            <column-instance column='[nombre]' derivation='None' name='[none:nombre:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4597520888897540]' derivation='Sum' name='[sum:Calculation_4597520888897540:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4597520888983558]' derivation='User' name='[usr:Calculation_4597520888983558:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4597520889913351]' derivation='User' name='[usr:Calculation_4597520889913351:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='label'>
            <format attr='text-format' field='[federated.17ivc3n0e99dkx18eolc30xt8auh].[usr:Calculation_4597520888983558:qk]' value='p0.00%' />
          </style-rule>
        </style>
