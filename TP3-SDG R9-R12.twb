    <worksheet name='R10 - Participación Lata'>
      <table>
        <view>
          <datasources>
            <datasource caption='ventas+' name='federated.17ivc3n0e99dkx18eolc30xt8auh' />
          </datasources>
          <datasource-dependencies datasource='federated.17ivc3n0e99dkx18eolc30xt8auh'>
            <column caption='Litros corregidos' datatype='real' name='[Calculation_4597520882618369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT([litros_venta]) / 3' />
            </column>
            <column caption='Participación Lata' datatype='real' name='[Calculation_4597520888266755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [envase] = &quot;Lata&quot; THEN [Calculation_4597520882618369]&#10;    ELSE 0&#10;    END&#10;)&#10;/&#10;SUM([Calculation_4597520882618369])' />
            </column>
            <column caption='Envase' datatype='string' name='[envase]' role='dimension' type='nominal' />
            <column caption='Fecha Venta' datatype='date' name='[fecha_venta]' role='dimension' type='ordinal' />
